# Copy to .env and fill in. Never commit .env.
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Supabase > Project Settings > Database > Connection string > "Session pooler" (works on IPv4)
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: Google sign-in on your local copy
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_EMAILS=
